rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /clinics/__CLINIC_SHORT_NAME__ {
      allow read, write: if true;
    }

    match /clinics/__CLINIC_SHORT_NAME__/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
