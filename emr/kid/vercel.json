{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/emr/kid",
      "destination": "/index.html"
    },
    {
      "source": "/emr/kid/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/emr/kid/(.*)\\.(.*)",
      "destination": "/$1.$2"
    },
    {
      "source": "/emr/kid/(.*)",
      "destination": "/$1.html"
    }
  ]
}
