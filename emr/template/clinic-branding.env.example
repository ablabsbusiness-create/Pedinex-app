# Copy this file to clinic-branding.env and fill in your clinic's
# details, then run `npm run apply-branding` (or scripts/apply-branding.js
# directly) to push these values into every page in one go.
#
# This is the non-interactive alternative to `npm run setup` -- edit
# this one file instead of answering prompts. Safe to re-run any time
# you change a value here.

CLINIC_NAME=
CLINIC_SHORT_NAME=
DOCTOR_NAME=
CLINIC_PHONE=
CLINIC_ADDRESS=
CLINIC_EMAIL=
CLINIC_DOMAIN=
WHATSAPP_NUMBER=
